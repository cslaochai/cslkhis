/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
  background: #f7f8fa;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, input, button, scroll-view {
  box-sizing: border-box;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* 通用按钮样式 */
button {
  margin: 0;
  padding: 0;
}

button::after {
  border: none;
}
