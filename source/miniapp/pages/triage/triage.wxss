.triage-page {
  min-height: 100vh;
  background: #f4f6f9;
  padding: 20rpx;
}

.banner {
  background: #1269b5;
  border-radius: 12rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.banner-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1269b5;
  margin-bottom: 16rpx;
}

.desc-input {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.primary-btn {
  margin-top: 20rpx;
  background: #1269b5;
  color: #fff;
  font-size: 30rpx;
  border: none;
}

.ghost-btn {
  margin-top: 20rpx;
  background: #eef4fb;
  color: #1269b5;
  font-size: 28rpx;
  border: none;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  font-size: 25rpx;
  color: #1269b5;
  background: #eef4fb;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
}

.dept-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 18rpx;
  border: 1rpx solid #eee;
  border-radius: 8rpx;
  margin-bottom: 14rpx;
}

.dept-row:last-child {
  margin-bottom: 0;
}

.dept-row.urgent {
  border-color: #f09595;
  background: #fdf0ef;
}

.dept-main {
  flex: 1;
}

.dept-name-line {
  display: flex;
  align-items: center;
}

.dept-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.urgent-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: #d0021b;
  border-radius: 4rpx;
  padding: 2rpx 12rpx;
}

.dept-reason {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #999;
}

.dept-slots {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #0f6e56;
}

.dept-slots.none {
  color: #999;
}

.dept-advice {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a33a10;
  line-height: 1.5;
}

.go {
  font-size: 26rpx;
  color: #1269b5;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.empty-result {
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
}

.disclaimer {
  padding: 20rpx 8rpx;
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.6;
  text-align: center;
}

.followup-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.followup-row:last-child {
  border-bottom: none;
}

.fu-q {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
}

.fu-go {
  font-size: 24rpx;
  color: #1269b5;
  padding-left: 16rpx;
}

.normalize-card .tag {
  background: #e8f4fd;
  color: #1269b5;
}
