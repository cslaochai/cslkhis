.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.empty-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #bbb;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.tag {
  font-size: 24rpx;
  color: #2b6cb0;
}

.row {
  display: flex;
  font-size: 26rpx;
  margin: 8rpx 0;
}

.label {
  width: 150rpx;
  color: #999;
  flex-shrink: 0;
}

.value {
  flex: 1;
  color: #333;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 88vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 26rpx;
  color: #999;
}

.sheet-body {
  flex: 1;
  max-height: calc(88vh - 100rpx);
}

.question {
  padding: 28rpx;
  border-bottom: 8rpx solid #f7f8fa;
}

.q-head {
  display: flex;
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.q-title {
  flex: 1;
  font-size: 28rpx;
  color: #222;
  line-height: 1.5;
}

.q-required {
  font-size: 22rpx;
  color: #c53030;
  background: #fff5f5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.q-optional {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 10rpx;
}

.score-row {
  display: flex;
  flex-wrap: wrap;
}

.score {
  width: 84rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  margin: 8rpx 12rpx 8rpx 0;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #333;
}

.score.small {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
}

.score.score-active {
  background: #2b6cb0;
  border-color: #2b6cb0;
  color: #fff;
}

.score-hint {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.q-input {
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 26rpx;
}

.q-textarea {
  width: 100%;
  min-height: 140rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 18rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.anon-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
}

.anon-label {
  font-size: 28rpx;
  color: #333;
}

.btn-primary {
  margin: 12rpx 28rpx 0;
  background: #2b6cb0;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.bottom-space {
  height: 40rpx;
}
