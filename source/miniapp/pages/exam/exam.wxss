.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  color: #2b6cb0;
  font-weight: 600;
  background: #eef4fb;
  border-radius: 12rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.empty-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #bbb;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.tag {
  font-size: 24rpx;
  color: #2b6cb0;
  background: #eef4fb;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.tag-urgent {
  color: #c53030;
  background: #fff5f5;
}

.row {
  display: flex;
  font-size: 26rpx;
  margin: 10rpx 0;
}

.label {
  width: 150rpx;
  color: #999;
  flex-shrink: 0;
}

.value {
  flex: 1;
  color: #333;
}

.value.strong {
  font-weight: 600;
  color: #2b6cb0;
}

.warn {
  color: #c53030;
}

.btn-primary {
  margin-top: 20rpx;
  background: #2b6cb0;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.btn-ghost {
  margin-top: 20rpx;
  background: #fff;
  color: #c53030;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-close {
  font-size: 26rpx;
  color: #999;
}

.sheet-body {
  flex: 1;
  max-height: calc(70vh - 100rpx);
}

.slot {
  display: flex;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.slot-main {
  display: flex;
  flex-direction: column;
}

.slot-date {
  font-size: 28rpx;
  color: #222;
}

.slot-time {
  font-size: 26rpx;
  color: #2b6cb0;
  margin-top: 6rpx;
}

.slot-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.slot-room {
  font-size: 24rpx;
  color: #999;
}

.slot-left {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}
