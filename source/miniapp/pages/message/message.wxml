<view class="page">
  <view class="list" wx:if="{{records.length > 0}}">
    <view class="item {{item.unread ? 'unread' : ''}}" wx:for="{{records}}" wx:key="messageId">
      <view class="item-top">
        <text class="badge">{{item.sceneText}}</text>
        <text class="time">{{item.sendTime}}</text>
        <view class="dot" wx:if="{{item.unread}}"></view>
      </view>
      <text class="title">{{item.title}}</text>
      <text class="content" wx:if="{{item.content}}">{{item.content}}</text>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && records.length === 0}}">
    <text class="empty-text">暂无消息</text>
  </view>

  <view class="foot" wx:if="{{finished && records.length > 0}}">
    <text class="foot-text">没有更多了</text>
  </view>
  <view class="foot" wx:if="{{loading}}">
    <text class="foot-text">加载中…</text>
  </view>
</view>
