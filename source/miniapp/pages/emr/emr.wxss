.emr-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 20rpx;
}

.banner {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 12rpx 8rpx 24rpx;
}

.banner-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.banner-sub {
  display: block;
  font-size: 26rpx;
  color: #2b6cb0;
  margin-top: 6rpx;
}

.banner-refresh {
  font-size: 26rpx;
  color: #2b6cb0;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.emr-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 26rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.emr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.emr-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.emr-dept {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.emr-status {
  font-size: 24rpx;
  color: #4caf50;
  background: #e8f5e9;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.emr-more {
  font-size: 24rpx;
  color: #999;
}

.emr-meta {
  font-size: 25rpx;
  color: #666;
  margin-top: 12rpx;
}

.emr-chief,
.emr-diagnosis {
  font-size: 25rpx;
  color: #444;
  margin-top: 10rpx;
  line-height: 1.5;
}

.emr-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.emr-action {
  font-size: 24rpx;
  color: #1269B5;
  padding: 8rpx 22rpx;
  border: 1rpx solid #d3e4f6;
  border-radius: 30rpx;
  background: #f3f8fd;
}

.emr-body {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f0f0;
}

.emr-row {
  display: flex;
  padding: 8rpx 0;
}

.row-label {
  flex: 0 0 190rpx;
  font-size: 25rpx;
  color: #999;
}

.row-value {
  flex: 1;
  font-size: 25rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.emr-none {
  font-size: 24rpx;
  color: #bbb;
  padding: 10rpx 0;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx 0;
}

.loading-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #2b6cb0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
