.profile-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: 60rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: #2b6cb0;
  padding: 60rpx 30rpx 80rpx;
  color: #fff;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  margin-right: 24rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.name {
  font-size: 36rpx;
  font-weight: 700;
}

.sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.overview {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin: -40rpx 20rpx 20rpx;
  padding: 30rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.ov-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ov-item + .ov-item {
  border-left: 1rpx solid #f0f0f0;
}

.ov-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.ov-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.menu {
  background: #fff;
  border-radius: 12rpx;
  margin: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}

.logout-btn {
  margin: 40rpx 20rpx 0;
  background: #fff;
  color: #f56c6c;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: 1rpx solid #f56c6c;
}
