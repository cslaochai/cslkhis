.page {
  padding: 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 600;
}

.amount {
  font-size: 32rpx;
  color: #d64545;
  font-weight: 600;
}

.sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.status {
  color: #0e9488;
}

.time {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.empty {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 120rpx 0;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.sheet-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.k {
  color: #6b7280;
}

.v {
  color: #1f2937;
}

.btn {
  margin-top: 28rpx;
  background: #1269b5;
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
}
