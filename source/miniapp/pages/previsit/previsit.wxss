.page {
  min-height: 100vh;
  background: #f4f6f9;
  padding: 20rpx;
  box-sizing: border-box;
}

.banner {
  background: #1269b5;
  border-radius: 12rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
}

.banner-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.banner-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.q-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.q-required {
  margin-left: 6rpx;
  color: #e53935;
  font-size: 28rpx;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tag {
  font-size: 25rpx;
  color: #1269b5;
  background: #eef4fb;
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
}

.tag.on {
  color: #fff;
  background: #1269b5;
}

.q-block {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f2f5;
}

.q-label {
  flex: 1;
  font-size: 27rpx;
  color: #444;
  line-height: 1.5;
}

.q-textarea {
  width: 100%;
  min-height: 110rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #333;
  background: #f7f8fa;
  border-radius: 8rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.q-textarea.free {
  margin-top: 20rpx;
  min-height: 150rpx;
}

.q-ph {
  color: #bbb;
}

.empty-card {
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.primary-btn {
  margin-top: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #fff;
  background: linear-gradient(96deg, #1269B5 0%, #0E9488 118%);
  box-shadow: 0 10rpx 22rpx rgba(18, 105, 181, 0.22);
}

.primary-btn::after {
  border: none;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #1269b5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
