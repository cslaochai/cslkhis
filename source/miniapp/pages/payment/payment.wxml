<view class="payment-page">
  <view class="summary" wx:if="{{list.length > 0}}">
    <text class="summary-label">待缴费合计</text>
    <text class="summary-amount">¥{{totalAmount}}</text>
  </view>

  <view class="list" wx:if="{{list.length > 0}}">
    <view class="pay-card" wx:for="{{list}}" wx:key="id">
      <view class="card-top">
        <text class="dept">{{item.deptName || '门诊'}}</text>
        <text class="amount">¥{{item.totalAmount}}</text>
      </view>
      <view class="card-sub">
        <text>单号 {{item.billNo}}</text>
        <text wx:if="{{item.encounterNo}}">就诊 {{item.encounterNo}}</text>
      </view>
      <view class="card-time">{{item.createTime}}</view>

      <!-- 账单级医保拆分：患者在缴费前就能看到「医保报多少、自己掏多少」 -->
      <view class="card-insurance" wx:if="{{item.hasInsurance}}">
        <text class="ins-tag">医保统筹 ¥{{item.poolAmount}}</text>
        <text class="ins-tag" wx:if="{{item.accountAmount !== '0.00'}}">个账 ¥{{item.accountAmount}}</text>
        <text class="ins-tag self">个人自付 ¥{{item.selfAmount}}</text>
      </view>

      <view class="detail-toggle" bindtap="toggleDetail" data-id="{{item.id}}">
        <text>{{item.expanded ? '收起明细' : '查看明细'}}</text>
      </view>
      <view class="detail-list" wx:if="{{item.expanded}}">
        <view class="detail-item" wx:for="{{item.details}}" wx:for-item="d" wx:key="index">
          <view class="d-line">
            <text class="d-name">{{d.itemName}}</text>
            <text class="d-amount">¥{{d.amount}}</text>
          </view>
          <view class="d-sub">
            <text class="d-catalog" wx:if="{{d.catalogTypeText}}">{{d.catalogTypeText}}</text>
            <text wx:if="{{d.quantity}}">{{d.quantity}}{{d.unit || ''}} × ¥{{d.price}}</text>
            <text class="d-split" wx:if="{{d.hasSplit}}">医保 ¥{{d.poolAmount}} · 自付 ¥{{d.selfAmount}}</text>
          </view>
        </view>
      </view>

      <!-- 费用解释：患者问「医保不是报 85% 吗，为什么我掏这么多」，这里自己能答 -->
      <view class="explain-row">
        <text class="explain-link" wx:if="{{!feeExplains[item.id]}}"
              data-id="{{item.id}}" bindtap="loadFeeExplain">
          {{feeExplainingId === item.id ? '计算中...' : '这笔钱怎么算的？'}}
        </text>
        <text class="explain-link close" wx:else data-id="{{item.id}}" bindtap="closeFeeExplain">收起说明</text>
      </view>

      <view class="fee-explain" wx:if="{{feeExplains[item.id]}}">
        <view class="fe-summary">{{feeExplains[item.id].summary}}</view>

        <view class="fe-block">
          <text class="fe-title">为什么自付这么多</text>
          <text class="fe-reason">{{feeExplains[item.id].reasonText}}</text>
        </view>

        <view class="fe-block" wx:if="{{feeExplains[item.id].catalogGroups.length}}">
          <text class="fe-title">按医保目录类别</text>
          <view class="fe-line" wx:for="{{feeExplains[item.id].catalogGroups}}" wx:for-item="g" wx:key="index">
            <text class="fe-name">{{g.catalogText}}</text>
            <text class="fe-amt">¥{{g.amount}}（{{g.ratio}}%）</text>
          </view>
          <view class="fe-rule" wx:for="{{feeExplains[item.id].catalogGroups}}" wx:for-item="g" wx:key="index">
            <text class="fe-cat">{{g.catalogText}}：</text>
            <text>{{g.ruleText}}</text>
          </view>
        </view>

        <view class="fe-block" wx:if="{{feeExplains[item.id].topSelfItems.length}}">
          <text class="fe-title">自付最多的项目</text>
          <view class="fe-line" wx:for="{{feeExplains[item.id].topSelfItems}}" wx:for-item="t" wx:key="index">
            <text class="fe-name">{{t.itemName}}（{{t.catalogText}}）</text>
            <text class="fe-amt">¥{{t.amount}}</text>
          </view>
        </view>

        <view class="fe-advice">{{feeExplains[item.id].advice}}</view>
      </view>

      <view class="card-actions">
        <button class="pay-btn" size="mini" data-id="{{item.id}}" bindtap="onPay" disabled="{{payingId === item.id}}">
          {{payingId === item.id ? '支付中...' : '去缴费'}}
        </button>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <image class="empty-icon" src="/images/icons/payment.svg" mode="aspectFit"/>
    <text class="empty-text">暂无待缴费项目</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>
</view>
