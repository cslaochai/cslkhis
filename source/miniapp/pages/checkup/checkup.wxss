.page {
  padding: 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 600;
}

.status {
  font-size: 24rpx;
  color: #0e9488;
}

.sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.empty {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 120rpx 0;
}

.empty.small {
  padding: 32rpx 0;
  font-size: 24rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.sheet-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.k {
  color: #6b7280;
}

.v {
  color: #1f2937;
}

.block {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f2f5;
}

.block-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1269b5;
  margin-bottom: 12rpx;
}

.block-text {
  font-size: 26rpx;
  color: #1f2937;
  line-height: 1.6;
}

.item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f7fa;
}

.item-name {
  font-size: 26rpx;
  color: #1f2937;
}

.item-flag {
  font-size: 24rpx;
  color: #6b7280;
}

.item-flag.abnormal {
  color: #d64545;
  font-weight: 600;
}

.item-summary {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7280;
}
