.page {
  min-height: 100vh;
  background: #f4f6f9;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

/* ---------- 顶部 ---------- */
.header {
  background: linear-gradient(150deg, #1269B5 0%, #1B77C4 46%, #0E9488 138%);
  padding: 20rpx 0 26rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 22rpx;
}

.head-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.head-link {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.86);
}

.date-strip {
  white-space: nowrap;
}

.date-inner {
  display: inline-flex;
  padding: 0 20rpx;
  gap: 12rpx;
}

.date-item {
  width: 112rpx;
  padding: 16rpx 0;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.14);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.date-item.active {
  background: #fff;
  box-shadow: 0 6rpx 16rpx rgba(11, 79, 138, 0.18);
}

.date-label {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.82);
}

.date-day {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 6rpx;
}

.date-item.active .date-label {
  color: #7b8a9c;
}

.date-item.active .date-day {
  color: #0B4F8A;
}

/* ---------- 步骤条 ---------- */
.steps {
  display: flex;
  align-items: center;
  padding: 26rpx 40rpx;
  background: #fff;
  border-bottom: 1rpx solid #edf0f4;
}

.step {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #e5eaf1;
  color: #98a2b3;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-name {
  font-size: 25rpx;
  color: #98a2b3;
}

.step.on .step-no {
  background: #1269B5;
  color: #fff;
}

.step.on .step-name {
  color: #1f2937;
  font-weight: 600;
}

.step-line {
  flex: 1;
  height: 2rpx;
  margin: 0 16rpx;
  background: #e5eaf1;
}

.step-line.on {
  background: #1269B5;
}

/* ---------- 通用 ---------- */
.body {
  padding: 24rpx;
}

.tip {
  font-size: 23rpx;
  color: #8c98a8;
  padding: 0 8rpx 18rpx;
}

.list {
  background: #fff;
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(18, 105, 181, 0.06);
}

.row {
  display: flex;
  align-items: center;
  padding: 26rpx 26rpx;
  border-bottom: 1rpx solid #f1f4f8;
}

.row:last-child {
  border-bottom: none;
}

.row:active {
  background: #f6f9fc;
}

.row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.row-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.row-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.row-sub {
  font-size: 24rpx;
  color: #8c98a8;
  margin-top: 8rpx;
}

.row-desc {
  font-size: 23rpx;
  color: #a3adbb;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.remain {
  font-size: 24rpx;
  color: #0E9488;
  font-weight: 600;
}

.chevron {
  font-size: 34rpx;
  color: #c3ccd8;
  line-height: 34rpx;
}

.chevron.dark {
  color: #c3ccd8;
}

.row-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #eaf2fb;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.row-icon-img {
  width: 36rpx;
  height: 36rpx;
}

.avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1269B5, #0E9488);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.badge.expert {
  background: #fff2e8;
  color: #d4691f;
}

.card {
  background: #fff;
  border-radius: 22rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(18, 105, 181, 0.06);
}

.crumb {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.crumb-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.crumb-change {
  font-size: 24rpx;
  color: #1269B5;
}

.card-sub {
  display: block;
  font-size: 24rpx;
  color: #8c98a8;
  margin-bottom: 20rpx;
}

/* ---------- 时段 ---------- */
.slot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.slot {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border: 2rpx solid #e6ebf2;
  border-radius: 18rpx;
  background: #fbfcfe;
}

.slot.on {
  border-color: #1269B5;
  background: #f0f7ff;
  box-shadow: 0 0 0 6rpx rgba(18, 105, 181, 0.06);
}

.slot-time {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  color: #1f2937;
}

.slot-remain {
  font-size: 24rpx;
  color: #0E9488;
  margin-right: 20rpx;
}

.slot-fee {
  font-size: 26rpx;
  font-weight: 600;
  color: #d4691f;
}

/* ---------- 表单 ---------- */
.form-row {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  border-bottom: 1rpx solid #f1f4f8;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 27rpx;
  color: #3d4757;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  font-size: 27rpx;
  color: #1f2937;
  font-weight: 500;
}

.form-value.placeholder {
  color: #b0b8c4;
  font-weight: 400;
}

.chips {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: 2rpx solid #e6ebf2;
  font-size: 25rpx;
  color: #3d4757;
  background: #fff;
}

.chip.on {
  border-color: #1269B5;
  color: #1269B5;
  background: #f0f7ff;
  font-weight: 600;
}

/* ---------- 费用 ---------- */
.fee-card {
  padding-bottom: 20rpx;
}

.fee-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.fee-row.total {
  margin-top: 10rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e6ebf2;
}

.fee-name {
  font-size: 26rpx;
  color: #8c98a8;
}

.fee-row.total .fee-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 600;
}

.fee-num {
  font-size: 26rpx;
  color: #3d4757;
}

.fee-row.total .fee-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #d4691f;
}

.fee-tip {
  display: block;
  font-size: 22rpx;
  color: #a3adbb;
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ---------- 提交 ---------- */
.submit-bar {
  padding: 8rpx 4rpx 0;
}

.submit {
  width: 440rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0 auto;
  border-radius: 38rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #fff;
  background: linear-gradient(96deg, #1269B5 0%, #0E9488 118%);
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(18, 105, 181, 0.22);
}

.submit::after {
  border: none;
}

.submit[disabled] {
  background: linear-gradient(96deg, #8fb0cb 0%, #8fc0bb 100%);
  color: rgba(255, 255, 255, 0.9);
  box-shadow: none;
}

/* ---------- 空态 / 错误 ---------- */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 60rpx;
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.5;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #6b7688;
}

.empty-sub {
  font-size: 24rpx;
  color: #a3adbb;
  margin-top: 10rpx;
}

.load-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 0;
  padding: 20rpx 26rpx;
  background: #fef1f0;
  border-radius: 18rpx;
}

.load-error-text {
  font-size: 25rpx;
  color: #e0544a;
}

.load-error-btn {
  font-size: 25rpx;
  color: #1269B5;
  font-weight: 600;
  padding-left: 20rpx;
}

.loading-bar {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  padding: 30rpx 0;
}

.loading-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1269B5;
  opacity: 0.35;
  animation: bounce 1.2s infinite ease-in-out;
}

.loading-dot:nth-child(2) { animation-delay: 0.16s; }
.loading-dot:nth-child(3) { animation-delay: 0.32s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.7); opacity: 0.3; }
  40% { transform: scale(1); opacity: 0.9; }
}

/* ---------- 结果页 ---------- */
.result {
  padding-top: 40rpx;
}

.result-icon {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: #e7f7f4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.result-icon-img {
  width: 56rpx;
  height: 56rpx;
}

.result-title {
  display: block;
  text-align: center;
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2937;
}

.result-no {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #8c98a8;
  margin: 12rpx 0 32rpx;
}

.result-card {
  padding: 10rpx 26rpx;
}

.kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f4f8;
}

.kv:last-child {
  border-bottom: none;
}

.kv-k {
  font-size: 26rpx;
  color: #8c98a8;
}

.kv-v {
  font-size: 27rpx;
  color: #1f2937;
  font-weight: 500;
}

.again {
  margin-top: 28rpx;
  text-align: center;
  font-size: 27rpx;
  color: #1269B5;
  padding: 16rpx 0;
}
