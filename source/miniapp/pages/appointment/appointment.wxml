<view class="page">
  <!-- 顶部：日期条常驻，切日期即刷新号源 -->
  <view class="header">
    <view class="head-row">
      <text class="head-title">{{selectedDate}} 号源</text>
      <text class="head-link" bindtap="goMyAppointments">我的预约 ›</text>
    </view>
    <scroll-view class="date-strip" scroll-x show-scrollbar="{{false}}" enhanced>
      <view class="date-inner">
        <view
          wx:for="{{dates}}"
          wx:key="value"
          class="date-item {{selectedDate === item.value ? 'active' : ''}}"
          bindtap="onDateTap"
          data-date="{{item.value}}"
        >
          <text class="date-label">{{item.label}}</text>
          <text class="date-day">{{item.day}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 步骤条：点已完成的步骤可回退 -->
  <view class="steps" wx:if="{{step < 4}}">
    <view class="step {{step >= 1 ? 'on' : ''}}" bindtap="goStep" data-step="1">
      <text class="step-no">1</text>
      <text class="step-name">选科室</text>
    </view>
    <view class="step-line {{step >= 2 ? 'on' : ''}}"></view>
    <view class="step {{step >= 2 ? 'on' : ''}}" bindtap="goStep" data-step="2">
      <text class="step-no">2</text>
      <text class="step-name">选医生</text>
    </view>
    <view class="step-line {{step >= 3 ? 'on' : ''}}"></view>
    <view class="step {{step >= 3 ? 'on' : ''}}" bindtap="goStep" data-step="3">
      <text class="step-no">3</text>
      <text class="step-name">确认挂号</text>
    </view>
  </view>

  <view class="load-error" wx:if="{{loadError}}">
    <text class="load-error-text">{{loadError}}</text>
    <text class="load-error-btn" bindtap="onRetry">重试</text>
  </view>

  <!-- 第一步：科室（只列所选日期有可约号源的科室） -->
  <view class="body" wx:if="{{step === 1}}">
    <view class="tip">仅展示 {{selectedDate}} 可线上预约的科室</view>

    <view class="list">
      <view class="row" wx:for="{{depts}}" wx:key="deptId" bindtap="onDeptTap" data-dept="{{item}}">
        <view class="row-icon dept-icon">
          <image class="row-icon-img" src="/images/icons/hospital.svg" mode="aspectFit"/>
        </view>
        <view class="row-main">
          <text class="row-title">{{item.deptName}}</text>
          <text class="row-sub">{{item.doctorCount}} 位医生出诊</text>
        </view>
        <view class="row-right">
          <text class="remain">余 {{item.remain}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{depts.length === 0 && !loading && !loadError}}">
      <image class="empty-icon" src="/images/icons/clock.svg" mode="aspectFit"/>
      <text class="empty-text">该日期暂无可预约号源</text>
      <text class="empty-sub">换个日期，或到院窗口挂号</text>
    </view>
  </view>

  <!-- 第二步：医生 -->
  <view class="body" wx:if="{{step === 2}}">
    <view class="crumb">
      <text class="crumb-name">{{selectedDept.deptName}}</text>
      <text class="crumb-change" bindtap="goStep" data-step="1">更换科室</text>
    </view>

    <view class="list">
      <view class="row doctor-row" wx:for="{{doctors}}" wx:key="doctorId" bindtap="onDoctorTap" data-doctor="{{item}}">
        <view class="avatar">
          <text class="avatar-text">{{item.doctorName[0]}}</text>
        </view>
        <view class="row-main">
          <view class="row-title-line">
            <text class="row-title">{{item.doctorName}}</text>
            <text class="badge expert" wx:if="{{item.isExpert === 1}}">专家</text>
          </view>
          <text class="row-sub">{{item.title || '医师'}} · {{item.timeText}}</text>
          <text class="row-desc" wx:if="{{item.specialty}}">擅长：{{item.specialty}}</text>
        </view>
        <view class="row-right">
          <text class="remain">余 {{item.remain}}</text>
          <text class="chevron">›</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{doctors.length === 0 && !loading && !loadError}}">
      <text class="empty-text">该科室当日暂无可约医生</text>
    </view>
  </view>

  <!-- 第三步：时段 + 就诊信息 + 提交 -->
  <view class="body" wx:if="{{step === 3}}">
    <view class="card">
      <view class="crumb">
        <text class="crumb-name">{{selectedDoctor.doctorName}}</text>
        <text class="crumb-change" bindtap="goStep" data-step="2">更换医生</text>
      </view>
      <text class="card-sub">{{selectedDoctor.deptName}} · {{selectedDate}}</text>

      <view class="slot-list">
        <view
          class="slot {{selectedSchedule.id === item.id ? 'on' : ''}}"
          wx:for="{{selectedDoctor.schedules}}"
          wx:key="id"
          bindtap="onScheduleTap"
          data-schedule="{{item}}"
        >
          <text class="slot-time">{{item.timeText}}</text>
          <text class="slot-remain">余 {{item.remain}} 号</text>
          <text class="slot-fee">¥{{item.feeText}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="form-row" bindtap="goPatients">
        <text class="form-label">就诊人</text>
        <text class="form-value {{patientName ? '' : 'placeholder'}}">
          {{patientName || '请选择就诊人'}}
        </text>
        <text class="chevron dark">›</text>
      </view>

      <view class="form-row">
        <text class="form-label">结算方式</text>
        <view class="chips">
          <text class="chip {{settlementType === 1 ? 'on' : ''}}" bindtap="onSettlementTap" data-type="1">自费</text>
          <text class="chip {{settlementType === 2 ? 'on' : ''}}" bindtap="onSettlementTap" data-type="2">职工医保</text>
          <text class="chip {{settlementType === 3 ? 'on' : ''}}" bindtap="onSettlementTap" data-type="3">居民医保</text>
        </view>
      </view>
    </view>

    <view class="card fee-card" wx:if="{{selectedSchedule}}">
      <view class="fee-row">
        <text class="fee-name">挂号费</text>
        <text class="fee-num">¥{{selectedSchedule.fee.regist}}</text>
      </view>
      <view class="fee-row">
        <text class="fee-name">诊查费</text>
        <text class="fee-num">¥{{selectedSchedule.fee.diagnosis}}</text>
      </view>
      <view class="fee-row" wx:if="{{selectedSchedule.fee.hasExpert}}">
        <text class="fee-name">专家费</text>
        <text class="fee-num">¥{{selectedSchedule.fee.expert}}</text>
      </view>
      <view class="fee-row total">
        <text class="fee-name">合计</text>
        <text class="fee-num">¥{{selectedSchedule.feeText}}</text>
      </view>
      <text class="fee-tip">到院后在自助机或收费窗口缴费，诊室候诊以现场叫号为准</text>
    </view>

    <view class="submit-bar">
      <button
        class="submit"
        loading="{{submitting}}"
        disabled="{{submitting || !selectedSchedule}}"
        bindtap="onConfirm"
      >{{submitting ? '提交中' : '确认挂号'}}</button>
    </view>
  </view>

  <!-- 第四步：结果 -->
  <view class="body" wx:if="{{step === 4}}">
    <view class="result">
      <view class="result-icon">
        <image class="result-icon-img" src="/images/icons/check.svg" mode="aspectFit"/>
      </view>
      <text class="result-title">挂号成功</text>
      <text class="result-no">就诊序号 {{result.registNo || '-'}}</text>

      <view class="card result-card">
        <view class="kv"><text class="kv-k">科室</text><text class="kv-v">{{result.deptName}}</text></view>
        <view class="kv"><text class="kv-k">医生</text><text class="kv-v">{{result.doctorName}}</text></view>
        <view class="kv"><text class="kv-k">就诊时间</text><text class="kv-v">{{result.visitDate}} {{result.timeText}}</text></view>
        <view class="kv"><text class="kv-k">就诊人</text><text class="kv-v">{{result.patientName}}</text></view>
        <view class="kv"><text class="kv-k">挂号费</text><text class="kv-v">￥{{result.feeText}}{{result.payStatus === 1 ? '（已缴）' : ''}}</text></view>
      </view>

      <button class="submit" wx:if="{{result.payStatus !== 1}}" bindtap="payRegFee" loading="{{paying}}">
        支付挂号费 ￥{{result.feeText}}</button>
      <button class="submit" bindtap="goMyAppointments">查看我的预约</button>
      <view class="again" bindtap="restart">再挂一个号</view>
    </view>
  </view>

  <view class="loading-bar" wx:if="{{loading}}">
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
    <view class="loading-dot"></view>
  </view>
</view>
