.appt-list-page {
  min-height: 100vh;
  background: #f7f8fa;
  padding: 20rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.appt-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.dept {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.status.active {
  background: #e8f5e9;
  color: #4caf50;
}

.status.done {
  background: #e3f2fd;
  color: #2196f3;
}

.status.cancelled {
  background: #f0f0f0;
  color: #999;
}

.card-row {
  display: flex;
  font-size: 26rpx;
  margin-bottom: 10rpx;
}

.card-row .label {
  width: 140rpx;
  color: #999;
}

.card-row .value {
  color: #333;
  flex: 1;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.cancel-btn {
  background: #fff;
  color: #f56c6c;
  border: 1rpx solid #f56c6c;
  font-size: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.55;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin: 20rpx 0 40rpx;
}

.go-btn {
  margin-top: 36rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #fff;
  background: linear-gradient(96deg, #1269B5 0%, #0E9488 118%);
  box-shadow: 0 10rpx 22rpx rgba(18, 105, 181, 0.22);
}

.go-btn::after {
  border: none;
}

.loading {
  display: flex;
  justify-content: center;
  padding: 40rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #e0e0e0;
  border-top-color: #2b6cb0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
