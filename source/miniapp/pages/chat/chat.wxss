.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8fa;
  position: relative;
  overflow: hidden;
}

/* ===== 顶部导航栏 ===== */
.nav-bar {
  height: 88rpx;
  padding: 0 20rpx;
  padding-top: env(safe-area-inset-top);
  background: #2b6cb0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.nav-back {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 20rpx 0 12rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.16);
}

.nav-back:active {
  background: rgba(255, 255, 255, 0.28);
}

.nav-back-arrow {
  font-size: 40rpx;
  line-height: 40rpx;
  color: #fff;
  margin-right: 4rpx;
}

.nav-back-text {
  font-size: 26rpx;
  color: #fff;
}

.nav-title {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

.nav-home {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 22rpx;
  border-radius: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.nav-home:active {
  background: rgba(255, 255, 255, 0.16);
}

.nav-home text {
  font-size: 24rpx;
  color: #fff;
}

/* ===== 主体滚动区 ===== */
.body {
  flex: 1;
  overflow: hidden;
  /* 底部转人工条是绝对定位，这里留出它的高度，否则最后一条 FAQ 永远被压住 */
  padding-bottom: 150rpx;
}

/* ===== 搜索 ===== */
.search-bar {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 12rpx;
  padding: 0 12rpx 0 24rpx;
  height: 76rpx;
  background: #fff;
  border-radius: 38rpx;
  box-shadow: 0 6rpx 20rpx rgba(27, 84, 136, 0.06);
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  color: #1f2937;
}

.search-clear {
  width: 48rpx;
  text-align: center;
  font-size: 34rpx;
  color: #98a2b3;
}

.search-btn {
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  background: #2b6cb0;
  color: #fff;
  font-size: 26rpx;
}

.search-btn:active {
  background: #245c99;
}

/* ===== 分区 ===== */
.card-section {
  margin: 20rpx 24rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  padding-left: 20rpx;
  position: relative;
  margin-bottom: 14rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: #2b6cb0;
}

.section-count {
  font-size: 24rpx;
  font-weight: 400;
  color: #98a2b3;
  margin-left: 12rpx;
}

/* ===== 快捷服务宫格 ===== */
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.service-card {
  background: #fff;
  border-radius: 22rpx;
  padding: 16rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 6rpx 20rpx rgba(27, 84, 136, 0.06);
}

.service-card:active {
  background: #f7fafc;
}

.service-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-icon {
  width: 34rpx;
  height: 34rpx;
}

.service-name {
  font-size: 25rpx;
  color: #3d4757;
}

/* ===== 分类标签 ===== */
.cat-tabs {
  white-space: nowrap;
  margin-bottom: 12rpx;
}

.cat-tab {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 30rpx;
  background: #fff;
  font-size: 25rpx;
  color: #5b6472;
}

.cat-tab.active {
  background: #2b6cb0;
  color: #fff;
}

/* ===== 常见问题 ===== */
.faq-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
  box-shadow: 0 6rpx 18rpx rgba(27, 84, 136, 0.05);
}

.faq-q {
  display: flex;
  align-items: flex-start;
}

.faq-q-tag {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #e8f4fd;
  color: #2b6cb0;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
}

.faq-q-text {
  flex: 1;
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.5;
}

.faq-arrow {
  flex-shrink: 0;
  width: 40rpx;
  text-align: center;
  font-size: 32rpx;
  color: #98a2b3;
}

.faq-a {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f2f5;
}

.faq-a-tag {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 8rpx;
  background: #e8f5e9;
  color: #3b6d11;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-top: 4rpx;
}

.faq-a-text {
  flex: 1;
  font-size: 26rpx;
  color: #5b6472;
  line-height: 1.7;
}

.faq-feedback {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-left: 48rpx;
}

.faq-feedback-tip {
  font-size: 23rpx;
  color: #98a2b3;
  margin-right: 16rpx;
}

.faq-btn {
  padding: 8rpx 22rpx;
  margin-right: 14rpx;
  border-radius: 24rpx;
  border: 1rpx solid #d6dbe3;
  font-size: 23rpx;
  color: #5b6472;
}

.faq-btn:active {
  background: #f2f5f9;
}

.empty-tip {
  padding: 60rpx 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #98a2b3;
  line-height: 1.7;
}

/* ===== 底部转人工 ===== */
.transfer-bar {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(27, 84, 136, 0.08);
}

.transfer-btn-item {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  border: 1rpx solid #2b6cb0;
}

.transfer-btn-item.primary {
  background: #2b6cb0;
  border: 1rpx solid #2b6cb0;
}

.transfer-btn-item:active {
  opacity: 0.86;
}

.transfer-btn-text {
  font-size: 29rpx;
  color: #2b6cb0;
}

.transfer-btn-text.light {
  color: #fff;
}

/* ===== 留言弹窗 ===== */
.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.msg-dialog {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
}

.msg-dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.msg-textarea {
  width: auto;
  height: 220rpx;
  padding: 20rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  font-size: 27rpx;
  color: #1f2937;
}

.msg-phone {
  margin-top: 18rpx;
  height: 84rpx;
  padding: 0 20rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  font-size: 27rpx;
}

.msg-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 26rpx;
}

.msg-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  border: 1rpx solid #d6dbe3;
  font-size: 29rpx;
  color: #5b6472;
}

.msg-btn.primary {
  background: #2b6cb0;
  border: 1rpx solid #2b6cb0;
  color: #fff;
}

.msg-history-link {
  margin-top: 22rpx;
  text-align: center;
  font-size: 25rpx;
  color: #2b6cb0;
}

/* ===== 我的留言记录 ===== */
.msg-list {
  max-height: 560rpx;
}

.msg-record {
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
}

.msg-record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.msg-record-no {
  font-size: 23rpx;
  color: #98a2b3;
}

.msg-status {
  font-size: 22rpx;
  color: #b7791f;
}

.msg-status.done {
  color: #3b6d11;
}

.msg-record-content {
  display: block;
  font-size: 27rpx;
  color: #1f2937;
  line-height: 1.6;
}

.msg-record-result {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #2b6cb0;
  line-height: 1.6;
}

.msg-record-time {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #98a2b3;
}

.msg-record-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #6b7280;
}

/* ===== 工单详情（进展时间轴） ===== */

.tk-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eef0f3;
}

.tk-status {
  font-size: 27rpx;
  font-weight: 600;
  color: #d97706;
}

.tk-status.done {
  color: #16a34a;
}

.tk-accept {
  font-size: 23rpx;
  color: #6b7280;
}

.tk-question {
  display: block;
  margin-top: 16rpx;
  font-size: 27rpx;
  color: #1f2937;
  line-height: 1.6;
}

.tk-close-reason {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #98a2b3;
}

.tk-timeline-title {
  display: block;
  margin: 24rpx 0 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: #374151;
}

.tk-timeline {
  padding-left: 8rpx;
}

.tk-node {
  display: flex;
  gap: 16rpx;
  padding-bottom: 20rpx;
}

.tk-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #2b6cb0;
}

.tk-node-body {
  flex: 1;
}

.tk-node-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.tk-node-action {
  font-size: 25rpx;
  color: #1f2937;
}

.tk-node-time {
  font-size: 21rpx;
  color: #98a2b3;
}

.tk-node-content {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #4b5563;
  line-height: 1.6;
}

.tk-node-operator {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #98a2b3;
}

.tk-append {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef0f3;
}

.tk-append-title {
  display: block;
  margin-bottom: 10rpx;
  font-size: 25rpx;
  color: #374151;
}

.tk-textarea,
.tk-input {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx;
  border: 1rpx solid #d7dbe0;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 26rpx;
  color: #1f2937;
}

.tk-textarea {
  height: 140rpx;
}

.tk-submit {
  margin-top: 16rpx;
  text-align: center;
}

.tk-action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.tk-action-row .msg-btn {
  flex: 1;
  text-align: center;
}
