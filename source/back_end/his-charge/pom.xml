<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.his</groupId>
        <artifactId>his-backend</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>his-charge</artifactId>
    <packaging>jar</packaging>
    <name>his-charge</name>
    <description>收费与结算：收费单、收款、发票、退费、医保结算清单、DRG、规则校验、质控、随访、公卫上报、病案归档、医技执行</description>

    <dependencies>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-system</artifactId>
        </dependency>
        <!--
            注意：his-charge 是记账与结算的底层模块，业务域（patient / emr / medicaltech /
            appoint …）反过来依赖它取记账能力。因此本模块<b>禁止</b>依赖任何业务域模块：
            一旦反向依赖，业务域同时依赖本模块就成环，Maven reactor 直接拒绝构建。
            需要读业务域数据时走本模块声明的 Gateway 端口（PatientGateway 等），
            由业务域实现，跨模块不得直连对方 Mapper 与实体。
        -->
        <!-- 支付二维码生成 -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
        </dependency>

        <!-- 支付渠道对接（收费台扫码支付） -->
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-pay</artifactId>
        </dependency>
    </dependencies>
</project>
