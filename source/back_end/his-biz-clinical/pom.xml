<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.his</groupId>
        <artifactId>his-backend</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>his-biz-clinical</artifactId>
    <packaging>jar</packaging>
    <name>his-biz-clinical</name>
    <description>临床域聚合模块：电子病历与专项质控（emr）、医技（medicaltech）、手术麻醉（operation）、药房药库（pharmacy）</description>

    <dependencies>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-core-common</artifactId>
        </dependency>

        <!-- 病历提交即开立项目：检查/检验/处方逐条落记账行，退单前的引用校验也查它 -->
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-biz-system</artifactId>
        </dependency>
        <!-- BI 国考四指标与 DRG 模拟页共用同一分组器（com.his.charge.drgdip.support），随 drg-dip 并入 charge -->
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-biz-charge</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
        </dependency>
        <!-- 记账经 ChargeApi（his-api 契约，his-charge 实现），不再直连收费模块；病历证据读取（EmrGateway 实现方在本模块） -->
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-core-api</artifactId>
        </dependency>
    </dependencies>
</project>
