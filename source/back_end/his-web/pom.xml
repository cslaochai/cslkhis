<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.his</groupId>
        <artifactId>his-backend</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>his-web</artifactId>
    <packaging>jar</packaging>
    <name>his-web</name>
    <description>启动层：应用入口、Spring/MyBatis-Plus/Security 配置、CORS、静态资源、运行配置</description>

    <dependencies>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-common</artifactId>
        </dependency>
        
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-system</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-patient</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-operation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-appoint</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-pharmacy</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-supplies</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-medicaltech</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-equipment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-emergency</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-charge</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-report</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>com.his</groupId>
            <artifactId>his-miniapp</artifactId>
        </dependency>

        <!--
            MySQL JDBC 驱动（运行期）。
            启动层创建 DataSource 且由本模块打包可执行 jar，驱动只需在此声明；
            版本由 spring-boot-starter-parent 统一管理（3.2.5 → mysql-connector-j 8.3.0）。
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>his-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.his.HisApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
