<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.his</groupId>
    <artifactId>his-backend</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>his-backend</name>
    <description>医疗HIS系统后端（聚合根：公共底座/跨模块契约/业务域/患者端小程序/启动层）</description>

    <properties>
        <!-- 统一 Java 21：Spring Boot 3.2 官方支持的最高长期版本；子模块一律不写 java.version，避免"某个模块偷偷按 17 编译"，
             那种错只在运行期以 UnsupportedClassVersionError 才暴露。 -->
        <java.version>21</java.version>
        <!-- UTF-8 必写：不写就取平台默认编码，Windows 上通常 GBK，含中文注释/中文文案的源文件编译后乱码，
             且构建不失败、只在日志留一条 warning，属于最难查的一类问题。 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ===== 第三方版本（每个都只在这里出现一次） ===== -->
        <!-- ORM：分页、逻辑删除 del_flag、字段自动填充、条件构造器。Boot3 必须配 -spring-boot3-starter（jakarta 版），
             用 Boot2 的 starter 在 21 + Boot3 下压根不注册 auto-configuration，现象是 Mapper 全部绑定不到。 -->
        <mybatis-plus.version>3.5.6</mybatis-plus.version>
        <!-- 在线 API 文档 UI（OpenAPI3）。jakarta 版是 Boot3 的唯一选择；开关在 application*.yml 的 knife4j 段，生产 profile 里应关掉。 -->
        <knife4j.version>4.4.0</knife4j.version>
        <!-- JWT：api / impl / jackson 三件必须同版本。混版本不会编译失败，而是在运行时找不到 SignatureAlgorithm 或抛 NoSuchMethodError，
             登录接口一调就 500 且堆栈指向框架内部。 -->
        <jjwt.version>0.12.5</jjwt.version>
        <!-- 通用工具（加解密、HTTP、树结构、日期等），全仓引用最广的第三方库之一 -->
        <hutool.version>5.8.26</hutool.version>
        <!-- 二维码生成/解析：支付码、腕带条码等（PayQrCodeUtils 与收费二维码链路在用） -->
        <zxing.version>3.5.3</zxing.version>
        <!-- PDF 生成：OpenPDF 是 iText 2 的社区分支，包名仍是 com.lowagie（源码里按全限定名使用，故没有 import 关键字可搜）。
             急诊值班表、医技报告 PDF 走这条链路；与 iText 7 是两套 API，不要混引。 -->
        <openpdf.version>1.3.30</openpdf.version>
        <!-- 微信支付 SDK：收费域 WxPayChannelService 的实现依赖它 -->
        <wx-java.version>4.6.0</wx-java.version>
        <!-- 支付宝 SDK：.ALL 版本已自带依赖，不要再手动叠加 httpclient/commons-logging 版本，否则签名工具类版本冲突 -->
        <alipay-sdk.version>4.38.0.ALL</alipay-sdk.version>
        <!-- 消息队列：RocketMQ Spring Boot Starter，发消息/回调用 -->
        <rocketmq-spring.version>2.3.2</rocketmq-spring.version>
        <!-- 国密：bcprov 提供 SM2/SM4 与 Provider，bcpkix 提供证书链解析。
             两个 artifact 必须同版本，并且整条链路（CA 推送验签 / 医保前置）只允许存在一个 BouncyCastle 版本：
             不同版本会注册多个同名 Provider，验签随机失败且无稳定复现路径。 -->
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <!-- PDF 解析（病历/清单文本抽取）。2.x 与 3.x 是两个不兼容的 API 代际（包名与构造器都变了），升级要连带改代码 -->
        <pdfbox.version>2.0.31</pdfbox.version>
        <!-- Excel 读写（导出/导入、报表）。poi-ooxml 负责 xlsx，版本与 poi 主包必须一致 -->
        <poi.version>5.2.5</poi.version>
        <!-- 向量库客户端：知识库 RAG 检索 -->
        <milvus.version>2.5.17</milvus.version>
        <!-- AI 图运行时：只用于 AI 能力内部的多步编排（检索 → 生成 → 校验），不接管工作流审批（那是 his-ms-workflow 的事） -->
        <spring-ai-alibaba.version>1.0.0.1</spring-ai-alibaba.version>
        <!-- Lombok：编译期注解处理器。版本必须放在 properties 里，
             因为各业务模块的 maven-compiler-plugin <annotationProcessorPaths> 要引用 ${lombok.version}（子模块无法从 dependencyManagement 取版本）。 -->
        <lombok.version>1.18.32</lombok.version>
    </properties>

    <!-- 构建集合：列在这里的模块才参与 mvn install。漏一个 = 它既不被构建也不被安装，
         依赖它的模块当场解析不到 jar（表现为"我刚写的类找不到"，而不是报某个模块出错）。
         顺序按"底座 → 契约 → SDK → 业务域 → 启动层"排，只为可读；真正构建顺序由 Maven 按依赖关系重排，不靠这里的位置。 -->
    <modules>
        <module>his-core-common</module>
        <module>his-core-spi</module>
        <module>his-ca-sdk</module>
        <module>his-ms-platform</module>
        <module>his-ms-patient</module>
        <module>his-ms-inpatient</module>
        <module>his-ms-clinical</module>
        <module>his-ms-medicaltech</module>
        <module>his-ms-charge</module>
        <module>his-ms-outpatient</module>
        <module>his-ms-pharmacy</module>
        <module>his-ms-operation</module>
        <module>his-ms-ai</module>
        <module>his-ms-workflow</module>
        <module>his-ms-app</module>
        <!-- 启动层：唯一可执行模块（repackage 出 fat jar，产物名 his-backend），放在最后便于阅读 -->
        <module>his-web</module>
    </modules>

    <!-- 版本集中管理：本段登记过的依赖，子模块 <dependency> 里一律不写 <version>、不写作用域，
         子模块只回答"我要不要"，版本由这里给。漏登记 = 想用的时候只能在自己 pom 里写死版本，版本就又漂出去了。
         新增第三方库：先在这里加一条，再在需要的模块里引用。 -->
    <dependencyManagement>
        <dependencies>
            <!-- ===== 本项目模块（版本统一 ${project.version}，改一处全仓同步） ===== -->
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-core-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-core-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- CA 对接 SDK：SM2 推送验签 + 开放接口客户端 -->
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ca-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-platform</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-patient</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-inpatient</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-clinical</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-medicaltech</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-charge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-outpatient</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-pharmacy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-operation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-ai</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.his</groupId>
                <artifactId>his-ms-app</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ===== 第三方 ===== -->
            <!-- ORM：Spring Boot 3 必须用 spring-boot3-starter（Jakarta 命名空间），不是 mybatis-plus-boot-starter -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- API 文档：jakarta 版 starter，his-core-common 引用它（全模块共享文档配置） -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- JWT：api 编译用 / impl 运行期实现 / jackson 负责 claims 序列化，三件同版本一起升 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- 二维码：只引 core，够生成/解析用，不引 javase（那部分带 AWT 图形界面依赖，服务端用不上） -->
            <dependency>
                <groupId>com.google.zxing</groupId>
                <artifactId>core</artifactId>
                <version>${zxing.version}</version>
            </dependency>

            <!-- PDF 生成：急诊值班表、医技报告 -->
            <dependency>
                <groupId>com.github.librepdf</groupId>
                <artifactId>openpdf</artifactId>
                <version>${openpdf.version}</version>
            </dependency>

            <!-- 支付 SDK -->
            <dependency>
                <groupId>com.github.binarywang</groupId>
                <artifactId>weixin-java-pay</artifactId>
                <version>${wx-java.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alipay.sdk</groupId>
                <artifactId>alipay-sdk-java</artifactId>
                <version>${alipay-sdk.version}</version>
            </dependency>

            <!-- 消息队列：RocketMQ Spring Boot Starter -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring.version}</version>
            </dependency>

            <!-- 国密：SM2 签名/验签、csssl 证书链（CA 推送与医保链路共用，版本必须一致） -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!-- 文档解析：病历/清单类 PDF、Excel 抽取 -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>

            <!-- 向量库：知识库检索 -->
            <dependency>
                <groupId>io.milvus</groupId>
                <artifactId>milvus-sdk-java</artifactId>
                <version>${milvus.version}</version>
            </dependency>

            <!-- AI 图运行时：只用于 AI 能力内部的多步编排，不接管工作流审批 -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-graph-core</artifactId>
                <version>${spring-ai-alibaba.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
