# 离线环境（132 无公网）：基础镜像 eclipse-temurin:21-jre 拉不到，
# 复用本地已有的 his-backend:local（同一基础镜像）作为运行时层，
# 替换为本系统 jar，并覆盖 ENTRYPOINT 指向业务名 jar。
FROM his-backend:local
COPY his-backend.jar /app/his-cslk.jar
ENTRYPOINT ["sh", "-c", "mkdir -p /app/logs /app/cslk-data/dumps && exec java $JAVA_OPTS -jar /app/his-cslk.jar"]
