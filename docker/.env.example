# 复制成同目录 .env 后填真值（.env 已在 .gitignore 里排除，禁止入库）。
# compose 的 env_file 把它整份注入 his-backend 容器，application-pro.yml 里对应项只有 ${HIS_*:} 占位。

SPRING_PROFILES_ACTIVE=pro

# 连接串里的 host 用 host.docker.internal：MySQL/Redis 是宿主机进程，不是容器
HIS_DB_URL=jdbc:mysql://host.docker.internal:3306/hn_biz_his?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
HIS_DB_USERNAME=
HIS_DB_PASSWORD=

HIS_REDIS_HOST=host.docker.internal
HIS_REDIS_PASSWORD=

HIS_JWT_SECRET=
# 电子签名主口令，生产必须覆盖
HIS_SIGN_SECRET=
# 阿里云百炼 OpenAI 兼容密钥；不填则 AI 能力降级成规则文案（不报错，但没有模型输出）
HIS_AI_API_KEY=
