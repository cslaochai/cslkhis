# 复制成同目录 .env 后填真值（.env 已在 .gitignore 里排除，禁止入库）。
# compose 的 env_file 把它整份注入 his-backend 容器，application-pro.yml 里对应项只有 ${HIS_*:} 占位。
# 本清单与 pro 文件引用的变量逐字对齐；不填即空串，被对应能力按「未配置」失败关闭。

SPRING_PROFILES_ACTIVE=pro

# 连接串里的 host 用 host.docker.internal：MySQL/Redis 是宿主机进程，不是容器
HIS_DB_URL=jdbc:mysql://host.docker.internal:3306/hn_biz_his?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
HIS_DB_USERNAME=
HIS_DB_PASSWORD=

HIS_REDIS_HOST=host.docker.internal
HIS_REDIS_PASSWORD=

HIS_JWT_SECRET=
# 电子签名主口令，生产必须覆盖（不填则拒绝签发证书）
HIS_SIGN_SECRET=
# 登录口令传输加密 SM2 私钥（16 进制 64 字符）；不填则每次启动临时生成，重启后前端缓存的公钥失效
HIS_SM2_PRIVATE_KEY=
# 阿里云百炼 OpenAI 兼容密钥；不填则 AI 能力降级成规则文案（不报错，但没有模型输出）
HIS_AI_API_KEY=

# 短信验证码测试开关：true=不走网关、验证码直接回显给调用方。漏配=false=注册功能不可用
HIS_SMS_MOCK=false

# 医保结算经办平台（his.insurance.channel.mode=remote 时生效）。
# 生产必须换成前置机地址；不填则回落 pro 文件里的 localhost 默认值（只够本机联调）
HIS_INSURANCE_MODE=remote
HIS_INSURANCE_BASE_URL=http://localhost:8090/mss

# 向量库（知识库问答 RAG）。his.ai.rag.vector-store=milvus 时必填，不填则知识库读写报「向量库不可用」
HIS_MILVUS_URL=
HIS_MILVUS_TOKEN=

# RocketMQ；不填则生产者建连失败，异步消息（MQ 主题见 com.his.common.mq.HisMqTopics）发不出去
HIS_ROCKETMQ_NAME_SERVER=
HIS_ROCKETMQ_PRODUCER_GROUP=HIS_PG_DEFAULT

# 微信支付。wxpay.mock-enabled 目前固定在 config/domain/his-pay.yml，接真渠道前要先改成 false
WX_PAY_APP_ID=
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_CERT_SERIAL_NO=
WX_PAY_PRIVATE_KEY_PATH=
WX_PAY_NOTIFY_URL=

# 支付宝支付
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=
ALIPAY_NOTIFY_URL=
ALIPAY_NOTIFY_URL_CASHIER=

# 云闪付支付
UNIONPAY_APP_ID=
UNIONPAY_MER_ID=
UNIONPAY_PRIVATE_KEY=
UNIONPAY_PUBLIC_KEY=
UNIONPAY_GATEWAY=

# 随访自动外呼（阿里云语音服务）。his.followup.call-channel 保持 mock 时整段可不填
HIS_CALL_ACCESS_KEY_ID=
HIS_CALL_ACCESS_KEY_SECRET=
HIS_CALL_SHOW_NUMBER=
HIS_CALL_TTS_CODE=
